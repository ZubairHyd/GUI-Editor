<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Java GUI Editor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .code-editor {
            font-family: 'Fira Code', 'Courier New', monospace;
            tab-size: 4;
            -moz-tab-size: 4;
            -o-tab-size: 4;
        }
        textarea::-webkit-scrollbar {
            width: 8px;
        }
        textarea::-webkit-scrollbar-track {
            background: #1f2937;
        }
        textarea::-webkit-scrollbar-thumb {
            background-color: #4b5563;
            border-radius: 20px;
            border: 3px solid #1f2937;
        }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 flex flex-col h-screen">

    <header class="bg-gray-800 shadow-md p-4 flex justify-between items-center">
        <h1 class="text-xl font-bold text-orange-400">Java GUI Editor (Swing)</h1>
        <button id="run-btn" class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300">
            Compile & Run
        </button>
    </header>

    <div class="flex flex-grow overflow-hidden">
        <!-- Code Editor Panel -->
        <div class="w-1/2 flex flex-col p-4">
            <h2 class="text-lg font-semibold mb-2">Java Code</h2>
            <div class="relative flex-grow bg-gray-800 rounded-lg shadow-inner">
                <textarea id="java-editor" class="code-editor w-full h-full p-4 bg-transparent resize-none focus:outline-none text-gray-200" spellcheck="false"></textarea>
            </div>
        </div>

        <!-- Simulated Preview Panel -->
        <div class="w-1/2 flex flex-col p-4">
            <h2 class="text-lg font-semibold mb-2">Simulated Preview</h2>
            <div id="preview-panel" class="flex-grow bg-gray-200 rounded-lg shadow-inner flex items-center justify-center">
                <div id="simulated-window" class="hidden bg-white rounded-lg shadow-2xl w-96 h-64 flex flex-col">
                    <div class="bg-gray-300 p-2 rounded-t-lg text-black text-sm font-semibold flex items-center">
                        <span class="w-3 h-3 bg-red-500 rounded-full inline-block mr-2"></span>
                        <span class="w-3 h-3 bg-yellow-500 rounded-full inline-block mr-2"></span>
                        <span class="w-3 h-3 bg-green-500 rounded-full inline-block mr-2"></span>
                        <span id="window-title" class="flex-grow text-center">Java App</span>
                    </div>
                    <div id="window-content" class="flex-grow p-4 flex flex-col items-center justify-center text-gray-800">
                        <!-- Content from Java code will be simulated here -->
                    </div>
                </div>
                <div id="placeholder-text" class="text-gray-500">Click "Compile & Run" to see a simulation of the GUI.</div>
            </div>
        </div>
    </div>

    <script>
        const javaEditor = document.getElementById('java-editor');
        const runBtn = document.getElementById('run-btn');
        const simulatedWindow = document.getElementById('simulated-window');
        const windowTitle = document.getElementById('window-title');
        const windowContent = document.getElementById('window-content');
        const placeholderText = document.getElementById('placeholder-text');

        const defaultJava = `import javax.swing.*;

public class MyFirstApp {
    public static void main(String[] args) {
        // Create a new frame (window)
        JFrame frame = new JFrame("My Swing App");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(400, 250);

        // Create a label
        JLabel label = new JLabel("Hello, Swing!", SwingConstants.CENTER);
        
        // Create a button
        JButton button = new JButton("Click Me!");

        // Add components to the frame
        frame.getContentPane().add(label, "Center");
        frame.getContentPane().add(button, "South");

        // Make the frame visible
        frame.setVisible(true);
    }
}
`;

        javaEditor.value = defaultJava;
        
        // Add tabbing support to textarea
        javaEditor.addEventListener('keydown', function(e) {
            if (e.key == 'Tab') {
                e.preventDefault();
                var start = this.selectionStart;
                var end = this.selectionEnd;
                this.value = this.value.substring(0, start) + "\t" + this.value.substring(end);
                this.selectionStart = this.selectionEnd = start + 1;
            }
        });

        runBtn.addEventListener('click', () => {
            const code = javaEditor.value;
            
            // Clear previous content
            windowContent.innerHTML = '';
            placeholderText.classList.add('hidden');
            simulatedWindow.classList.remove('hidden');

            // --- Basic simulation logic ---
            // This is a very simplified parser and does not actually execute Java.
            
            // Simulate window title
            const titleMatch = code.match(/new JFrame\("([^"]+)"\)/);
            if (titleMatch && titleMatch[1]) {
                windowTitle.textContent = titleMatch[1];
            } else {
                windowTitle.textContent = 'Java App';
            }

            // Simulate a label
            const labelMatch = code.match(/new JLabel\("([^"]+)"/);
            if (labelMatch && labelMatch[1]) {
                const labelElement = document.createElement('p');
                labelElement.textContent = labelMatch[1];
                labelElement.className = 'text-lg mb-4 flex-grow text-center flex items-center justify-center';
                windowContent.appendChild(labelElement);
            }
            
            // Simulate a button
            const buttonMatch = code.match(/new JButton\("([^"]+)"\)/);
             if (buttonMatch && buttonMatch[1]) {
                const buttonElement = document.createElement('button');
                buttonElement.textContent = buttonMatch[1];
                buttonElement.className = 'bg-gray-200 text-black py-2 px-10 rounded border border-gray-400';
                windowContent.appendChild(buttonElement);
            }
        });
    </script>
</body>
</html>

